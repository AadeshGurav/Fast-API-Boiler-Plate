# Copied to .env by `make setup` with random passwords. Never commit .env.
# docker compose reads the unprefixed names; the app reads the FABP_ ones (any setting can
# be given this way, see docs/CONFIGURATION.md).
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me
REDIS_PASSWORD=change-me
POSTGRES_PASSWORD=change-me

# Host ports for the Docker services (make setup picks free ones).
APP_HOST_PORT=8000
MONGO_HOST_PORT=27017
REDIS_HOST_PORT=6379
POSTGRES_HOST_PORT=5432
FABP_MONGO_PORT=27017
FABP_APP_PORT=8000
FABP_REDIS_PORT=6379
FABP_POSTGRES_PORT=5432

FABP_MONGO_USERNAME=root
FABP_MONGO_PASSWORD=change-me
FABP_REDIS_PASSWORD=change-me
FABP_POSTGRES_PASSWORD=change-me
FABP_JWT_SECRET=change-me-generated-by-make-setup
FABP_MFA_ENCRYPTION_KEY=change-me-generated-by-make-setup
